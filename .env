# Default: every CTF module starts with `just up`. To skip some,
# create a gitignored `modules.env` with a reduced COMPOSE_PROFILES
# list (see README → "Selecting modules"). modules.env wins over .env.
COMPOSE_PROFILES=json,oidc,rest,saml,soap,web,xml,passkeys,maze,rookies,recruiting,catcher

BASE_PATH_JSON=/json-sec
BASE_PATH_OIDC_IDP=/oidc_idp
BASE_PATH_OIDC_SP=/oidc_sp
BASE_PATH_REST=/rest-api-sec
BASE_PATH_SAML_IDP=/idp
BASE_PATH_SAML_SP=/sp
BASE_PATH_WEBSEC=/websec
CATCHER_ENABLE_API=false
CATCHER_HOST=e-attacker.de
CATCHER_INSTANCE_TTL_DAYS=30
CATCHER_MAX_BODY_BYTES=1048576
CATCHER_MAX_REQUESTS_PER_SALT=1000
CATCHER_URL_STYLE=subdomain
CRAWLING_MAZE_HOST=crawling.e-hacking.de
DASHBOARD_HOST=dashboard.e-hacking.de
# In-network resolver (see dns/Corefile). The subnet is pinned only so the
# resolver can hold a fixed address — clients can name it by IP only.
# Verify it does not collide with an existing network: podman network ls
DNS_RESOLVER_IP=10.53.0.53
EHACKING_SUBNET=10.53.0.0/24
HOST1=e-hacking.de
HOST2=www.e-hacking.de
# Host-side publish only; the firewall preroutes 80→10080 / 443→10443.
# Keeps rootless podman off privileged ports. See README → "Ports".
HOST_PORT_HTTP=10080
HOST_PORT_HTTPS=10443
IDP_HOST=idp.e-hacking.de
JSON_HOST=json.e-hacking.de
PASSKEYS_HOST=passkeys.e-hacking.de
PASSKEYS_ORIGIN=https://passkeys.e-hacking.de
PASSKEYS_RP_ID=passkeys.e-hacking.de
# PUBLIC ports: must equal the port clients put in their URLs, because
# they also reach the modules as env vars. Keep at 80/443.
PORT_HTTP=80
PORT_HTTPS=443
RECRUITING_BOT_HOST=bot.recruiting.e-hacking.de
RECRUITING_CHALLENGE_HOST=challenge.recruiting.e-hacking.de
RECRUITING_INSTRUCTOR_HOST=instructor.recruiting.e-hacking.de
RECRUITING_TIER_HOST=recruiting.e-hacking.de
REST_HOST=rest.e-hacking.de
ROOKIES_HOST=rookies.e-hacking.de
RS_HOST=rs.e-hacking.de
SOAP_HOST=soap.e-hacking.de
SP_HOST=sp.e-hacking.de
SPA_HOST=spa.e-hacking.de
WEBSEC_HOST=websec.e-hacking.de
XML_HOST=xml.e-hacking.de
